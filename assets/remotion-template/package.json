{
  "name": "storyboard-visual-style-template-3-0",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "compositions": "remotion compositions src/index.ts",
    "render": "remotion render src/index.ts StoryboardTemplate-Layouts renders/storyboard-template-showcase.mp4 --codec=h264 --muted",
    "still": "remotion still src/index.ts Layout-Decision renders/storyboard-template-still.png --frame=125",
    "render:surfaces": "remotion render src/index.ts StoryboardTemplate-Surfaces renders/card-surfaces-showcase.mp4 --codec=h264 --muted",
    "render:semantic": "remotion render src/index.ts StoryboardTemplate-SemanticMotion renders/semantic-motion-showcase.mp4 --codec=h264 --muted",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.484",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
